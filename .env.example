# Copy to `.env` (or `.env.production`) and fill in the values for your environment.

# Router base path
VITE_PUBLIC_URL=/

# Apollo / Webiny GraphQL endpoints
VITE_READ_API_URL=
VITE_MAIN_API_URL=
VITE_MANAGE_API_URL=
VITE_TOKEN=

# Webiny File Manager folder that uploaded feed images are placed in
VITE_WEBINY_FOLDER_ID=

# Public base URL (with trailing slash) that hosts uploaded feed image files
VITE_CLOUDFRONT_FILES_URL=
